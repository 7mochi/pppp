{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xmake: compile commands",
      "type": "shell",
      "command": "${config:xmake.executable}",
      "args": ["project", "-k", "compile_commands", "--lsp=clangd", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
