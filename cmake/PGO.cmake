set(PPPP_PGO OFF CACHE STRING "Profile-guided optimisation: OFF, GENERATE or USE")
set_property(CACHE PPPP_PGO PROPERTY STRINGS OFF GENERATE USE)
if(NOT PPPP_PGO MATCHES "^(OFF|GENERATE|USE)$")
  message(FATAL_ERROR "PPPP_PGO must be OFF, GENERATE or USE, not ${PPPP_PGO}")
endif()

if(NOT DEFINED PPPP_PGO_DIR)
  set(PPPP_PGO_DIR "${CMAKE_BINARY_DIR}/../profile-data")
endif()

if(PPPP_PGO STREQUAL "GENERATE")
  if(MSVC)
    string(APPEND CMAKE_C_FLAGS " /GL")
    string(APPEND CMAKE_CXX_FLAGS " /GL")
    foreach(type EXE SHARED MODULE)
      foreach(config RELWITHDEBINFO RELEASE)
        set(flag "CMAKE_${type}_LINKER_FLAGS_${config}")
        string(APPEND "${flag}" " /LTCG /GENPROFILE")
      endforeach()
    endforeach()
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    string(APPEND CMAKE_C_FLAGS " -fprofile-generate")
    string(APPEND CMAKE_CXX_FLAGS " -fprofile-generate")
  else()
    string(APPEND CMAKE_C_FLAGS " -fprofile-generate=${PPPP_PGO_DIR}")
    string(APPEND CMAKE_CXX_FLAGS " -fprofile-generate=${PPPP_PGO_DIR}")
  endif()
endif()

if(PPPP_PGO STREQUAL "USE")
  if(MSVC)
    string(APPEND CMAKE_C_FLAGS " /GL")
    string(APPEND CMAKE_CXX_FLAGS " /GL")
    foreach(type EXE SHARED MODULE)
      foreach(config RELWITHDEBINFO RELEASE)
        set(flag "CMAKE_${type}_LINKER_FLAGS_${config}")
        string(APPEND "${flag}" " /LTCG /USEPROFILE")
      endforeach()
    endforeach()
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    string(APPEND CMAKE_REQUIRED_FLAGS " -Wno-missing-profile")
    string(APPEND CMAKE_C_FLAGS " -fprofile-use -fprofile-correction -fprofile-partial-training")
    string(APPEND CMAKE_CXX_FLAGS " -fprofile-use -fprofile-correction -fprofile-partial-training")
  else()
    string(APPEND CMAKE_C_FLAGS " -fprofile-use=${PPPP_PGO_DIR}")
    string(APPEND CMAKE_CXX_FLAGS " -fprofile-use=${PPPP_PGO_DIR}")
  endif()
endif()
