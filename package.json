  "description": "osu! difficulty and performance calculation for all four gamemodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7mochi/pppp.git"
  },
  "main": "./node/index.js",
  "types": "./node/module.d.ts",
