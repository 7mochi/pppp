{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  schedule: ["before 6am on monday"],
  labels: ["dependencies"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
  },
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      pinDigests: true,
    },
    {
      matchManagers: ["nix"],
      groupName: "nix",
    },
  ],
}
