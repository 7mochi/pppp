{
  "name": "@7mochi/pppp",
  "version": "0.0.0",
  "description": "osu! difficulty and performance calculation for all four gamemodes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7mochi/pppp.git"
  },
  "main": "./node/index.js",
  "types": "./node/module.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./node/module.d.ts",
      "import": "./node/index.js",
      "require": "./node/index.js"
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "types": "tsc --noEmit --strict --target es2020 node/module.d.ts node/tests/types.ts",
    "lint": "biome check --write node",
    "lint:check": "biome check node"
  },
  "files": [
    "/node/index.js",
    "/node/module.d.ts",
    "/node/native.g.js",
    "/node/attributes.js",
    "/node/async.js",
    "/node/beatmap.js",
    "/node/constants.js",
    "/node/difficulty.js",
    "/node/errors.js",
    "/node/library.js",
    "/node/mods.js",
    "/node/names.js",
    "/node/performance.js",
    "/node/ruleset.js",
    "/node/strains.js",
    "/node/native",
    "/LICENCE",
    "/README.md"
  ],
  "dependencies": {
    "koffi": "^3.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
