    "/CMakeLists.txt",
    "/LICENCE",
    "/README.md"
  ],
  "dependencies": {
    "cmake-js": "^8.0.0",
    "pkg-prebuilds": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^30.0.0"
  }
}
