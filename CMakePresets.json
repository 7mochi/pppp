{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PPPP_BUILD_TESTS": "ON",
        "PPPP_BUILD_PYTHON": "ON",
        "PPPP_BUILD_CAPI": "ON"
      }
    },
    {
      "name": "clang_tidy",
      "displayName": "Development with clang-tidy",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build_clang_tidy",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;-p;${sourceDir}/build_clang_tidy"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    }
  ]
}
